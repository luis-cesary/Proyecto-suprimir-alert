ZBX_API_URL=https://sim.itqlatam.com/api_jsonrpc.php
ZBX_API_TOKEN=REEMPLAZAR
DEFAULT_GROUP=Banco estado
DEFAULT_DAYS=14
DEFAULT_SEVERITY=4
DRY_RUN=true
MAX_WRITE_EVENTS=300
DEBUG=false
SUPPRESSION_MESSAGE=Suprimido por superar el tiempo de espera aprobado con el cliente.
ZBX_TIMEOUT=30
# Ruta opcional a un bundle PEM de CA interna. Nunca se desactiva TLS.
ZBX_CA_FILE=
# Regex completas alternativas separadas por ;;. Deben identificar F5 y Pool/VS.
F5_NAME_PATTERNS=(?i)\bF5\b.*\b(pool|virtual server|VS)\b
# Alternativa: etiqueta F5 exacta + patrón de recurso en el nombre.
# Pares separados por ; (OR); nombres/valores sin distinción de mayúsculas.
F5_TAGS=vendor=F5
F5_RESOURCE_PATTERN=(?i)\b(pool|virtual server|VS)\b

# Automatización diaria. Para una pasada sin parámetros: python ejecutar_automatico.py
# Requiere DRY_RUN=false y la autorización/permisos de este bloque.
AUTO_ENABLED=false
AUTO_PERMISSIONS_VERIFIED=false
AUTO_APPROVAL_REFERENCE=
AUTO_GROUP_NAME=BANCO ESTADO
# Vacío: todos los equipos del grupo. Opcional: hostids separados por comas.
AUTO_HOST_IDS=
# Vacío: sin restricción IP. Opcional: IP/CIDR separados por comas.
AUTO_INCLUDE_IPS=
AUTO_DAYS=14
# Severidad mínima 4: High y Disaster.
AUTO_MIN_SEVERITY=4
AUTO_MAX_EVENTS_PER_DAY=100
AUTO_DAILY_AT=00:01
